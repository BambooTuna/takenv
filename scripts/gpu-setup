#!/usr/bin/env bash
# NVIDIA GPU をコンテナから使えるようにする（NVIDIA Container Toolkit の導入と docker 連携設定）。
# GPU が載っていないマシンもあるので bootstrap.sh からは切り出し、必要なマシンだけで手動実行する。
#
#   make gpu-setup
#
# 冪等: 既に導入・設定済みなら何もしない。動作確認まで済ませて成功メッセージで終わる。
# 対応: Linux (WSL2 経由の GPU passthrough を含む)。macOS は Metal で完結するため対象外。
set -euo pipefail

log()  { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m⚠\033[0m %s\n' "$*"; }
err()  { printf '  \033[31m✗\033[0m %s\n' "$*" >&2; }

SUDO=""
[ "$(id -u)" -ne 0 ] && SUDO="sudo"

# ---------------------------------------------------------------- 事前チェック
check_prereqs() {
  log "事前チェック"

  if [ "$(uname -s)" != "Linux" ]; then
    err "Linux 専用です (現在: $(uname -s))。macOS は Metal で完結するためこの手順は不要です。"
    exit 1
  fi

  if ! command -v docker >/dev/null 2>&1; then
    err "docker が見つかりません。先に ./bootstrap.sh を実行してください。"
    exit 1
  fi
  ok "docker: $(docker --version | head -1)"

  # WSL2 では /dev/dxg + libcuda.so、ネイティブ Linux では /dev/nvidia* が GPU の目印
  if [ -e /dev/dxg ] && [ -e /usr/lib/wsl/lib/libcuda.so.1 ]; then
    ok "WSL2 の GPU passthrough を検出"
  elif ls /dev/nvidia* >/dev/null 2>&1; then
    ok "NVIDIA GPU デバイスを検出"
  else
    err "NVIDIA GPU が検出できませんでした (/dev/dxg も /dev/nvidia* も無し)。"
    err "Windows/ホスト側の GPU ドライバが入っているか確認してください。"
    exit 1
  fi
}

# ---------------------------------------------------------------- nvidia-smi の PATH 追加 (WSL2)
install_nvidia_smi_link() {
  log "nvidia-smi の PATH 追加"

  # 既に PATH で解決できるなら何もしない（ネイティブ Linux で nvidia-utils が入っている場合を含む）
  if command -v nvidia-smi >/dev/null 2>&1; then
    ok "nvidia-smi: $(command -v nvidia-smi)"
    return
  fi

  # WSL2 の GPU passthrough では /usr/lib/wsl/lib/nvidia-smi に実体があるが PATH に含まれない
  if [ ! -e /usr/lib/wsl/lib/nvidia-smi ]; then
    warn "nvidia-smi が見つかりません (/usr/lib/wsl/lib/nvidia-smi も無し)。ネイティブ Linux なら nvidia-utils を導入してください。"
    return
  fi

  if $SUDO ln -sf /usr/lib/wsl/lib/nvidia-smi /usr/local/bin/nvidia-smi; then
    ok "nvidia-smi: /usr/local/bin/nvidia-smi -> /usr/lib/wsl/lib/nvidia-smi"
  else
    warn "/usr/local/bin/nvidia-smi へのリンク作成に失敗しました。"
  fi
}

# ---------------------------------------------------------------- btop (GPU 対応版)
install_btop_gpu() {
  log "btop (GPU 対応版)"

  # btop の GPU 対応は libnvidia-ml を dlopen して実現する。公式の musl 静的リリースは
  # dlopen 不可のため GPU_SUPPORT=false でビルドされている。Ubuntu 配布版は動的リンクで
  # GPU_SUPPORT=true が有効なので、apt からそちらを入れる。
  if command -v btop >/dev/null 2>&1 && btop --version 2>/dev/null | grep -q 'GPU_SUPPORT=true'; then
    ok "導入済み ($(btop --version | head -1))"
  else
    DEBIAN_FRONTEND=noninteractive $SUDO apt-get install -y btop >/dev/null
    if btop --version 2>/dev/null | grep -q 'GPU_SUPPORT=true'; then
      ok "導入完了 ($(btop --version | head -1))"
    else
      warn "btop は入りましたが GPU_SUPPORT=true を確認できませんでした。"
    fi
  fi

  # 過去にこのスクリプトが release バイナリを /usr/local/bin/btop に置いた残骸があると、
  # apt 版 (/usr/bin/btop) より PATH で先勝ちしてしまい GPU 非対応版が使われる。掃除する。
  if [ -e /usr/local/bin/btop ]; then
    warn "/usr/local/bin/btop に旧版が残っています。apt 版を優先させるため削除します。"
    $SUDO rm -f /usr/local/bin/btop
  fi

  # mise 経由の btop は GPU 非対応 (musl 静的) で、mise の install dir が PATH 上位に来るため
  # apt 版に勝ってしまう。GPU マシンでは自動で uninstall して apt 版を勝たせる。
  # config には残しておき、GPU 無いマシンでは CPU 版として引き続き使う。
  if command -v mise >/dev/null 2>&1 && mise ls btop 2>/dev/null | grep -q .; then
    mise uninstall btop >/dev/null 2>&1 || true
    ok "mise 版 btop を uninstall (CPU 版が PATH で先勝ちしないようにするため)"
  fi
}

# ---------------------------------------------------------------- Toolkit 導入
install_toolkit() {
  log "NVIDIA Container Toolkit"

  if command -v nvidia-ctk >/dev/null 2>&1; then
    ok "インストール済み ($(nvidia-ctk --version | head -1))"
    return
  fi

  local keyring=/usr/share/keyrings/nvidia-container-toolkit-keyring.gpg
  local list=/etc/apt/sources.list.d/nvidia-container-toolkit.list

  if [ ! -f "$keyring" ]; then
    curl -fsSL https://nvidia.github.io/libnvidia-container/gpgkey \
      | $SUDO gpg --dearmor -o "$keyring"
  fi
  if [ ! -f "$list" ]; then
    curl -fsSL https://nvidia.github.io/libnvidia-container/stable/deb/nvidia-container-toolkit.list \
      | sed "s#deb https://#deb [signed-by=$keyring] https://#" \
      | $SUDO tee "$list" >/dev/null
  fi

  $SUDO apt-get update -y
  DEBIAN_FRONTEND=noninteractive $SUDO apt-get install -y nvidia-container-toolkit
  ok "導入完了"
}

# ---------------------------------------------------------------- docker 連携
configure_docker() {
  log "docker ランタイム設定"

  # /etc/docker/daemon.json に nvidia ランタイムが登録されていなければ書き足す
  local daemon=/etc/docker/daemon.json
  if [ -f "$daemon" ] && grep -q '"nvidia"' "$daemon" 2>/dev/null; then
    ok "nvidia ランタイム登録済み"
  else
    $SUDO nvidia-ctk runtime configure --runtime=docker
    ok "daemon.json に nvidia ランタイムを追記"
  fi

  # docker サービス再起動 (WSL では service、systemd 環境では systemctl)
  if command -v systemctl >/dev/null 2>&1 && systemctl is-system-running >/dev/null 2>&1; then
    $SUDO systemctl restart docker
  else
    $SUDO service docker restart
  fi
  ok "docker 再起動"
}

# ---------------------------------------------------------------- 動作確認
verify() {
  log "動作確認 (コンテナから nvidia-smi を叩く)"

  if docker run --rm --gpus all nvidia/cuda:12.6.0-base-ubuntu22.04 nvidia-smi >/tmp/gpu-verify.log 2>&1; then
    ok "コンテナから GPU が見えています"
    grep -E 'Driver Version|GeForce|Tesla|Quadro|RTX|GTX' /tmp/gpu-verify.log | sed 's/^/    /' || true
  else
    err "動作確認に失敗しました。ログ: /tmp/gpu-verify.log"
    tail -20 /tmp/gpu-verify.log >&2
    exit 1
  fi
}

# ---------------------------------------------------------------- main
main() {
  check_prereqs
  install_nvidia_smi_link
  install_btop_gpu
  install_toolkit
  configure_docker
  verify

  log "完了 🎉"
  cat <<'EOS'
  btop を起動すると GPU タブが表示されます（表示されない場合はシェルを開き直してください）。

  Ollama を GPU 有効で立ち上げる例:
    docker run -d --name ollama --gpus all -p 11434:11434 \
      -v ollama:/root/.ollama --restart unless-stopped ollama/ollama
    docker exec -it ollama ollama run qwen3:4b

  剥がしたくなったら:
    sudo apt-get remove --purge -y nvidia-container-toolkit
    sudo rm -f /etc/apt/sources.list.d/nvidia-container-toolkit.list \
              /usr/share/keyrings/nvidia-container-toolkit-keyring.gpg
EOS
}

main "$@"
