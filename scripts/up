#!/usr/bin/env bash
# 普段起動しておきたい常駐サービスを foreground で一括起動する。
# 各サービスは背景ジョブとして走り、ログはこの端末にまとめて流れる。
# Ctrl+C (SIGINT) または SIGTERM で全部まとめて止まる。
#
# サービス追加は下の「サービス登録」セクションに1行足す:
#   start_service <ラベル> <コマンド> [args...]
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

# ---- pre-flight: cli-proxy-api の設定を冪等に用意 --------------------------
# docker-compose.yml が bind mount する側の実体が無いと Docker が空ディレクトリを
# 掘ってしまい `read /CLIProxyAPI/config.yaml: is a directory` で落ちるため、
# ここで先回りして用意する。既に存在するときは何もしない。
CLI_PROXY_CONFIG="${HOME}/.config/cli-proxy-api/config.yaml"
CLI_PROXY_AUTH_DIR="${HOME}/.cli-proxy-api"
CLI_PROXY_CONFIG_URL="https://raw.githubusercontent.com/router-for-me/CLIProxyAPI/main/config.example.yaml"

# Docker が先に空ディレクトリを掘ってしまった場合の救済（空のときだけ rmdir)
if [[ -d "$CLI_PROXY_CONFIG" ]]; then
	echo "▶ cli-proxy-api: $CLI_PROXY_CONFIG が空ディレクトリなので撤去します"
	rmdir "$CLI_PROXY_CONFIG" || {
		echo "✗ cli-proxy-api: $CLI_PROXY_CONFIG を撤去できません（中身あり）"
		exit 1
	}
fi

if [[ ! -f "$CLI_PROXY_CONFIG" ]]; then
	echo "▶ cli-proxy-api: config.yaml が無いので upstream から取得します"
	mkdir -p "$(dirname "$CLI_PROXY_CONFIG")"
	if ! curl -fsSL -o "$CLI_PROXY_CONFIG" "$CLI_PROXY_CONFIG_URL"; then
		echo "✗ cli-proxy-api: config.example.yaml の取得に失敗しました ($CLI_PROXY_CONFIG_URL)"
		exit 1
	fi
	echo "✓ cli-proxy-api: $CLI_PROXY_CONFIG を作成しました"
fi

mkdir -p "$CLI_PROXY_AUTH_DIR"
# ---------------------------------------------------------------------------

pids=()
labels=()

start_service() {
	local label=$1; shift
	"$@" &
	local pid=$!
	pids+=("$pid")
	labels+=("$label")
	echo "▶ started $label (pid=$pid)"
}

cleanup() {
	trap - INT TERM EXIT
	echo ""
	echo "▶ stopping all services..."
	for p in "${pids[@]}"; do
		kill -TERM "$p" 2>/dev/null || true
	done
	# TERM で降りるのを最大 3 秒待つ
	for _ in 1 2 3 4 5 6; do
		local alive=0
		for p in "${pids[@]}"; do
			kill -0 "$p" 2>/dev/null && { alive=1; break; }
		done
		[[ $alive -eq 0 ]] && break
		sleep 0.5
	done
	# 残ってたら強制 kill
	for p in "${pids[@]}"; do
		if kill -0 "$p" 2>/dev/null; then
			echo "  ! pid $p not responding, sending KILL"
			kill -KILL "$p" 2>/dev/null || true
		fi
	done
	wait 2>/dev/null || true
	echo "▶ all stopped"
}
trap cleanup INT TERM EXIT

# ---- サービス登録: ここに追加していく ----------------------------------
start_service cli-proxy-api \
	docker compose -f "$REPO_ROOT/docker-compose.yml" up cli-proxy-api

start_service tmuxui \
	docker compose -f "$REPO_ROOT/docker-compose.yml" up tmuxui
# ------------------------------------------------------------------------

echo "▶ ${#pids[@]} services running (Ctrl+C to stop all)"
wait
