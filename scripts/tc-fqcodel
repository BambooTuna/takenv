#!/usr/bin/env bash
# eth0 の qdisc を fq_codel に置換して bufferbloat を抑え、
# tailscale ssh (WireGuard UDP) と docker pull (TCP) の帯域競合を公平化する。
# 対策として fq_codel はフロー単位で公平化するため、SSH パケットに TOS マーキングが
# 乗らない tailscale 経由でも構造的に効く。
#
# 使い方:
#   sudo tc-fqcodel install     /usr/local/sbin と systemd unit を導入して enable+start
#   sudo tc-fqcodel apply       eth0 の mq 子 qdisc を fq_codel に置換 (systemd から呼ばれる)
#        tc-fqcodel status      現在の qdisc を表示
#   sudo tc-fqcodel uninstall   unit を disable+削除しカーネル既定 (mq/pfifo_fast) に戻す
#
# 冪等: 何度実行しても安全。install 後の apply は systemd oneshot がブート毎に走る。
set -euo pipefail

IFACE="${IFACE:-eth0}"
UNIT_PATH="/etc/systemd/system/tc-fqcodel.service"
BIN_PATH="/usr/local/sbin/tc-fqcodel"

log()  { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m⚠\033[0m %s\n' "$*"; }
err()  { printf '  \033[31m✗\033[0m %s\n' "$*" >&2; }

need_root() {
  if [ "$(id -u)" -ne 0 ]; then
    err "root 権限が必要です: sudo $0 $1"
    exit 1
  fi
}

apply_fqcodel() {
  if [ ! -e "/sys/class/net/$IFACE" ]; then
    err "$IFACE が見つかりません"
    return 1
  fi

  # 方針: root ごと fq_codel に置換する。
  # mq 配下の子キューを個別に fq_codel 化する方法もあるが、tc の handle 割当が
  # カーネルバージョン (特に WSL2 の 6.18 系) で不安定で失敗しやすい。root 置換なら
  # 1 コマンドで安定して当たり、フロー公平化 (SSH と docker pull の共存) の目的は
  # 同等に達成できる。WSL2 の仮想 NIC (hv_netvsc) では mq のキュー並列性による
  # スループット向上は限定的なのでトレードオフは小さい。
  tc qdisc replace dev "$IFACE" root fq_codel
  ok "$IFACE: root qdisc を fq_codel に置換"
}

cmd_apply() {
  need_root apply
  apply_fqcodel
}

cmd_status() {
  echo "== $IFACE qdisc =="
  tc qdisc show dev "$IFACE"
}

cmd_install() {
  need_root install

  # scripts/tc-fqcodel をそのまま /usr/local/sbin にコピーして安定パスから呼ぶ。
  # ホームディレクトリの実体パスは環境差があるため単純コピー。
  install -m 0755 "$(readlink -f "$0")" "$BIN_PATH"
  ok "$BIN_PATH にインストール"

  cat > "$UNIT_PATH" <<EOF
[Unit]
Description=Apply fq_codel qdisc to $IFACE (bufferbloat mitigation)
After=network.target
Wants=network.target

[Service]
Type=oneshot
ExecStart=$BIN_PATH apply
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF
  ok "$UNIT_PATH を書き込み"

  systemctl daemon-reload
  # 直前の apply 失敗が残っていると enable --now が start をスキップする挙動があるため、
  # 明示的に reset-failed してから enable + restart する (restart は inactive でも start と同義)。
  systemctl reset-failed tc-fqcodel.service 2>/dev/null || true
  systemctl enable tc-fqcodel.service >/dev/null 2>&1 || true
  if systemctl restart tc-fqcodel.service; then
    ok "tc-fqcodel.service を enable + start"
  else
    err "tc-fqcodel.service の起動に失敗しました。journalctl -xeu tc-fqcodel.service を確認してください"
    exit 1
  fi

  echo
  cmd_status
}

cmd_uninstall() {
  need_root uninstall

  if systemctl list-unit-files tc-fqcodel.service >/dev/null 2>&1; then
    systemctl disable --now tc-fqcodel.service || true
    ok "tc-fqcodel.service を disable"
  fi
  if [ -f "$UNIT_PATH" ]; then
    rm -f "$UNIT_PATH"
    systemctl daemon-reload
    ok "$UNIT_PATH を削除"
  fi
  if [ -f "$BIN_PATH" ]; then
    rm -f "$BIN_PATH"
    ok "$BIN_PATH を削除"
  fi
  # qdisc をカーネル既定 (mq + pfifo_fast) に戻す。root 削除で自動的に再生成される。
  if [ -e "/sys/class/net/$IFACE" ]; then
    tc qdisc delete dev "$IFACE" root 2>/dev/null || true
    ok "$IFACE の qdisc をカーネル既定に戻し"
  fi
}

case "${1:-}" in
  install)   cmd_install ;;
  apply)     cmd_apply ;;
  status)    cmd_status ;;
  uninstall) cmd_uninstall ;;
  ""|help|-h|--help)
    sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
    ;;
  *)
    err "不明なコマンド: $1"
    exit 1
    ;;
esac
