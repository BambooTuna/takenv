#!/bin/sh
# tmux copy-pipe-and-cancel から呼ばれ、選択内容を OSC 52 でクリップボードへ送る。
#
# なぜ必要か:
#   tmux set-clipboard on による自発的 OSC 52 発火は mosh 経由ではクライアントに
#   届かない。一方、pane に書き込まれた OSC 52 は tmux passthrough → mosh →
#   端末 と中継される。そこで本スクリプトが pane tty に直接書き出すことで、
#   mosh/ssh 共通で動作する経路に乗せる。
#
# 呼ばれ方:
#   bind -T copy-mode-vi y send -X copy-pipe-and-cancel '$HOME/.local/bin/osc52-yank'
#   copy-pipe は stdin に選択内容を流し、stdout は pane に流れないため
#   $TMUX_PANE から pane tty を解決して直接書き出す。

b64=$(base64 | tr -d '\n')
seq=$(printf '\033Ptmux;\033\033]52;c;%s\007\033\\' "$b64")

if [ -n "$TMUX_PANE" ]; then
  pane_tty=$(tmux display-message -t "$TMUX_PANE" -p '#{pane_tty}' 2>/dev/null)
  if [ -n "$pane_tty" ] && [ -w "$pane_tty" ]; then
    printf '%s' "$seq" > "$pane_tty"
    exit 0
  fi
fi

# フォールバック: stdout へ（tmux外や直接シェル実行時）
printf '%s' "$seq"
