#!/bin/sh
# SSH ローカルポートフォワードをフォアグラウンドで張る (Ctrl+C で切断)。
# リモートの開発サーバーを手元の localhost として見るための専用コマンド。
#
# 使い方:
#   fwd <user@host> <port[,port...]>
#
# 例:
#   fwd sekine@desktop.taild59847.ts.net 3100,8100        # FE/BE を手元 localhost へ
#   fwd sekine@desktop.taild59847.ts.net 3100,8100,5436   # DB も覗くとき
#   fwd pi@raspberrypi.taild59847.ts.net 8080             # Raspberry Pi
#
# ポートはローカル・リモートとも同じ番号で対応付ける。

set -eu

if [ $# -ne 2 ]; then
  echo "usage: fwd <user@host> <port[,port...]>" >&2
  exit 1
fi

target=$1
ports=$2

case "$target" in
  *@*) ;;
  *)
    echo "fwd: user@host 形式で指定してください (例: pi@raspberrypi.local)" >&2
    exit 1
    ;;
esac

fwd_args=""
for p in $(printf '%s' "$ports" | tr ',' ' '); do
  case "$p" in
    ''|*[!0-9]*)
      echo "fwd: 不正なポート番号です: $p" >&2
      exit 1
      ;;
  esac
  fwd_args="$fwd_args -L ${p}:localhost:${p}"
done

echo "fwd: ${ports} -> ${target} (Ctrl+C で終了)"
# shellcheck disable=SC2086
exec ssh -N $fwd_args "${target}"
