import os
import re
import shutil
import signal
import subprocess
import sys
import threading
import time
import urllib.parse
from http.server import BaseHTTPRequestHandler, SimpleHTTPRequestHandler, ThreadingHTTPServer
from string import Template

INBOX = os.environ.get("DROPSERVE_DIR") or os.path.expanduser("~/.dropserve")
MAX_BYTES = int(os.environ.get("DROPSERVE_MAX_MB") or 10240) << 20
RATE_LIMIT_BPS = float(os.environ.get("DROPSERVE_RATE_MBPS") or 0) * 1024 * 1024
DEFAULT_LIFETIME_SEC = 3600
MAX_LIFETIME_SEC = 24 * 3600  # 「ちょっと共有」用ツールで無限占有させないためのハードキャップ
CHUNK = 1 << 20  # multipart のストリーミング読み出し単位 (1MB)

PAGE = """<!doctype html>
