<div id="zone">ここにファイルをドロップ<br><small>またはクリックして選択</small></div>
<input type="file" id="picker" multiple hidden>
<div id="log"></div>
<script>
const zone = document.getElementById('zone'), picker = document.getElementById('picker'), log = document.getElementById('log');
zone.onclick = () => picker.click();
picker.onchange = () => upload(picker.files);
zone.ondragover = e => { e.preventDefault(); zone.classList.add('over'); };
zone.ondragleave = () => zone.classList.remove('over');
zone.ondrop = e => { e.preventDefault(); zone.classList.remove('over'); upload(e.dataTransfer.files); };

function copyText(text) {
  // navigator.clipboard は HTTPS/localhost 限定なので、平文 HTTP では textarea 方式で書き込む
  if (navigator.clipboard && window.isSecureContext) return navigator.clipboard.writeText(text);
  const ta = document.createElement('textarea');
  ta.value = text;
  ta.style.position = 'fixed';
  ta.style.opacity = '0';
  document.body.appendChild(ta);
  ta.focus();
  ta.select();
  const ok = document.execCommand('copy');
  ta.remove();
  return ok ? Promise.resolve() : Promise.reject(new Error('copy failed'));
}

function fmtMB(bytes) { return (bytes / 1048576).toFixed(1); }
function fmtEta(sec) {
  if (!isFinite(sec) || sec < 0) return '';
  if (sec < 90) return Math.round(sec) + 's';
  return Math.round(sec / 60) + 'm';
}

// fetch は送信進捗を取れないので XHR を使う。呼び出し側で中断できるよう xhr 自体を返す。
function xhrUpload(file, onProgress) {
  const xhr = new XMLHttpRequest();
  const promise = new Promise((resolve, reject) => {
    const fd = new FormData();
    fd.append('file', file);
    xhr.open('POST', '/upload');
    xhr.upload.onprogress = e => { if (e.lengthComputable) onProgress(e.loaded, e.total); };
    xhr.onload = () => {
      let j = {};
      try { j = JSON.parse(xhr.responseText); } catch (e) {}
      if (xhr.status >= 200 && xhr.status < 300) resolve(j.path);
      else reject(new Error(j.error || ('HTTP ' + xhr.status)));
    };
    xhr.onerror = () => reject(new Error('接続に失敗しました'));
    xhr.onabort = () => reject(new Error('中断されました'));
    xhr.send(fd);
  });
  return { xhr, promise };
}

async function upload(files) {
  for (const f of files) {
    const div = document.createElement('div');
    div.className = 'item progress';
    const head = document.createElement('div');
    head.className = 'head';
    const name = document.createElement('div');
    name.className = 'name';
    name.textContent = f.name;
    const cancelBtn = document.createElement('button');
    cancelBtn.className = 'cancel';
    cancelBtn.textContent = '中断';
    head.append(name, cancelBtn);
    const bar = document.createElement('div');
    bar.className = 'bar';
    const fill = document.createElement('div');
    fill.className = 'fill';
    bar.appendChild(fill);
    const status = document.createElement('div');
    status.className = 'status';
    status.textContent = '準備中…';
    div.append(head, bar, status);
    log.prepend(div);

    // 直近サンプルから指数移動平均で速度を出す (瞬間値だとブレが大きい)
    let lastMs = performance.now(), lastLoaded = 0, ema = 0;

    const req = xhrUpload(f, (loaded, total) => {
      const now = performance.now();
      const dt = now - lastMs;
      if (dt >= 250) {
        const inst = (loaded - lastLoaded) / dt * 1000;
        ema = ema ? ema * 0.7 + inst * 0.3 : inst;
        lastMs = now; lastLoaded = loaded;
      }
      const pct = total ? loaded / total * 100 : 0;
      fill.style.width = pct.toFixed(1) + '%';
      const rate = ema ? fmtMB(ema) + ' MB/s' : '…';
      const eta = ema && total ? fmtEta((total - loaded) / ema) : '';
      status.textContent = fmtMB(loaded) + ' / ' + fmtMB(total) + ' MB  (' + pct.toFixed(1) + '%)  ' + rate + (eta ? '  残り ' + eta : '');
    });
    cancelBtn.onclick = () => { cancelBtn.disabled = true; cancelBtn.textContent = '中断中…'; req.xhr.abort(); };

    try {
      const path = await req.promise;
      fill.style.width = '100%';
      div.className = 'item fresh';
      div.innerHTML = '<code></code><button>コピー</button>';
      div.querySelector('code').textContent = path;
      div.querySelector('button').onclick = ev => {
        copyText(path).then(
          () => { ev.target.textContent = '✓'; div.classList.remove('fresh'); },
          () => { ev.target.textContent = '失敗'; },
        );
        setTimeout(() => ev.target.textContent = 'コピー', 1200);
      };
    } catch (err) {
      cancelBtn.remove();
      status.className = 'status err';
      status.textContent = '失敗: ' + err.message;
    }
  }
}
</script>
"""


class QuietThreadingHTTPServer(ThreadingHTTPServer):
    """クライアント切断のトレースだけ握り潰す。動画配信で頻発するがサーバー側は正常。"""

    def handle_error(self, request, client_address):
        exc = sys.exc_info()[1]
        if isinstance(exc, (BrokenPipeError, ConnectionResetError)):
            return
        super().handle_error(request, client_address)


def tailscale_addr():
    """bind は Tailscale の IPv4、表示 URL は MagicDNS ホスト名を優先。"""
    try:
        ip = subprocess.run(
            ["tailscale", "ip", "-4"], capture_output=True, text=True, timeout=5
        ).stdout.split()
        ip = ip[0] if ip else ""
    except OSError:
        ip = ""
    if not ip:
        sys.exit("tailscale IP を取得できません。tailscale が起動しているか確認してください。")
    host = ""
    try:
        status = subprocess.run(
            ["tailscale", "status", "--self", "--json"],
            capture_output=True, text=True, timeout=5,
        ).stdout
        host = json.loads(status)["Self"]["DNSName"].rstrip(".")
    except (OSError, KeyError, ValueError):
        pass
    return ip, host or ip


def bind_with_fallback(handler, ip, port, attempts=20):
    """指定ポートが使用中なら +1 しながら空きを探す。"""
    for p in range(port, port + attempts):
        try:
            return QuietThreadingHTTPServer((ip, p), handler), p
        except OSError as e:
            if e.errno != errno.EADDRINUSE:
                raise
            print(f"port {p} は使用中、{p + 1} を試します", file=sys.stderr)
    sys.exit(f"error: port {port}〜{port + attempts - 1} すべて使用中")


def _resolve_cloudflared():
    """PATH に居なくても mise 直下から拾えるようにフォールバックする。"""
    path = shutil.which("cloudflared")
    if path:
        return path
    try:
        r = subprocess.run(["mise", "which", "cloudflared"], capture_output=True, text=True, timeout=5)
        cand = r.stdout.strip()
        if r.returncode == 0 and cand and os.access(cand, os.X_OK):
            return cand
    except OSError:
        pass
    return None


def start_cloudflared(target_url, url_path=""):
    """cloudflared quick tunnel を起動し、trycloudflare.com URL を検出したら表示する。

    子プロセスとその出力を吸うスレッドを返し、呼び出し側は終了時に proc.terminate() する。
    """
    exe = _resolve_cloudflared()
    if not exe:
        sys.exit(
            "cloudflared が見つかりません。~/takenv で `mise install` を実行するか、"
            "PATH を通してから再実行してください。"
        )
    # --no-autoupdate は quick tunnel でも周期チェックが走るのを抑えるため
    proc = subprocess.Popen(
        [exe, "tunnel", "--no-autoupdate", "--url", target_url],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
    )

    pat = re.compile(r"https://[A-Za-z0-9-]+\.trycloudflare\.com")

    def _pump():
        printed = False
        for line in proc.stderr:
            if not printed:
                m = pat.search(line)
                if m:
                    sep = "" if url_path.startswith("/") or not url_path else "/"
                    print(f"→ {m.group(0)}{sep}{url_path}  (公開URL)", flush=True)
                    printed = True

    t = threading.Thread(target=_pump, daemon=True)
    t.start()
    return proc


def run(handler, port, url_path="", public=False, lifetime=DEFAULT_LIFETIME_SEC):
    """bind →自動終了タイマー→ URL 表示→サーブ、の共通処理。"""
    ip, host = tailscale_addr()
    srv, port = bind_with_fallback(handler, ip, port)
    timer = threading.Timer(lifetime, srv.shutdown)
    timer.daemon = True
    timer.start()
    # パイプ/リダイレクト時もすぐ URL が見えるよう flush する
    print(f"→ http://{host}:{port}/{url_path}  ({_fmt_duration(lifetime)}後に自動終了)", flush=True)
    tunnel = start_cloudflared(f"http://{ip}:{port}", url_path) if public else None
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        if tunnel is not None:
            tunnel.send_signal(signal.SIGINT)
            try:
                tunnel.wait(timeout=5)
            except subprocess.TimeoutExpired:
                tunnel.kill()
    print("自動終了しました" if not timer.is_alive() else "終了しました")


def _parse_duration(s):
    """`30m` `4h` `1d` `90s` `3600` → 秒数。単位なしは秒とみなす。"""
    m = re.fullmatch(r"\s*(\d+)\s*([smhd]?)\s*", s)
    if not m:
        sys.exit(f"--ttl: 数値+単位(s/m/h/d) で指定してください: {s!r}")
    n = int(m.group(1))
    unit = {"": 1, "s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)]
    return n * unit


def _extract_flags(argv):
    """argv から --public と --ttl <D> を抜き出す。位置引数は順序保持。"""
    out, public, ttl = [], False, DEFAULT_LIFETIME_SEC
    it = iter(argv)
    for a in it:
        if a == "--public":
            public = True
        elif a == "--ttl":
            try:
                ttl = _parse_duration(next(it))
            except StopIteration:
                sys.exit("--ttl には値が必要です (例: --ttl 4h)")
        elif a.startswith("--ttl="):
            ttl = _parse_duration(a[len("--ttl="):])
        else:
            out.append(a)
    if ttl < 60:
        sys.exit("--ttl は 60 秒以上を指定してください")
    if ttl > MAX_LIFETIME_SEC:
        print(f"⚠ --ttl は上限 {_fmt_duration(MAX_LIFETIME_SEC)} にキャップされました", flush=True)
        ttl = MAX_LIFETIME_SEC
    return out, public, ttl


def _fmt_duration(sec):
    if sec % 86400 == 0:
        return f"{sec // 86400}日"
    if sec % 3600 == 0:
        return f"{sec // 3600}時間"
    if sec % 60 == 0:
        return f"{sec // 60}分"
    return f"{sec}秒"


