# 拡張子 → 表示アイコンのラフな分類。判定はディレクトリ index の見た目だけに使う。
_ICON_MAP = [
    ("🎬", {"mp4", "mov", "mkv", "webm", "avi", "m4v"}),
    ("🎵", {"mp3", "wav", "flac", "ogg", "m4a", "aac", "opus"}),
    ("🖼", {"jpg", "jpeg", "png", "gif", "webp", "svg", "heic", "bmp", "ico", "avif"}),
    ("🌐", {"html", "htm"}),
    ("📕", {"pdf"}),
    ("📦", {"zip", "tar", "gz", "tgz", "bz2", "7z", "rar", "xz"}),
]


def _file_icon(name):
    ext = os.path.splitext(name)[1].lower().lstrip(".")
    for icon, exts in _ICON_MAP:
        if ext in exts:
            return icon
    return "📄"


def _fmt_size(n):
    unit = "B"
    for u in ("B", "KB", "MB", "GB", "TB"):
        unit = u
        if n < 1024:
            break
        n /= 1024
    return f"{n:.0f} {unit}" if unit == "B" else f"{n:.1f} {unit}"


class _RangedFile:
    """send_head が返すファイルラッパ。read() で length ぶんまでに切り詰める。

    Range 応答時に SimpleHTTPRequestHandler.copyfile(f, wfile) が f を EOF まで読むと
    レンジ外まで送ってしまうので、read で残量を管理して EOF を偽装する。
    """

    def __init__(self, f, length):
        self.f = f
        self.remaining = length

    def read(self, n=-1):
        if self.remaining <= 0:
            return b""
        if n is None or n < 0 or n > self.remaining:
            n = self.remaining
        data = self.f.read(n)
        self.remaining -= len(data)
        return data

    def close(self):
        return self.f.close()


class ServeHandler(SimpleHTTPRequestHandler):
    """SimpleHTTPRequestHandler に以下を足したハンドラ。

    - Range: bytes= を受け付けて 206 で部分応答する (動画のシーク再生に必要)。
      Range 非対応のままだと Chrome/Safari が <video> 再生を諦めてダウンロードにフォールバックする
    - ディレクトリ index を独自 HTML に差し替え、各行に ⬇ ダウンロードボタンを付ける
    - ?download=1 が付いていれば Content-Disposition: attachment を返す (通常は inline)
    """

    def log_message(self, fmt, *args):
        sys.stderr.write("%s %s\n" % (self.address_string(), fmt % args))

    def send_head(self):
        parts = urllib.parse.urlsplit(self.path)
        download = "download" in urllib.parse.parse_qs(parts.query)
        path = self.translate_path(self.path)

        if os.path.isdir(path):
            if not parts.path.endswith("/"):
                # ディレクトリは末尾スラッシュを強制 (相対リンクが基点を誤らないため)
                self.send_response(301)
                new = (parts.scheme, parts.netloc, parts.path + "/", parts.query, parts.fragment)
                self.send_header("Location", urllib.parse.urlunsplit(new))
                self.send_header("Content-Length", "0")
                self.end_headers()
                return None
            for index in ("index.html", "index.htm"):
                candidate = os.path.join(path, index)
                if os.path.isfile(candidate):
                    path = candidate
                    break
            else:
                return self.list_directory(path)

        if path.endswith("/"):
            self.send_error(404, "File not found")
            return None

        try:
            f = open(path, "rb")
        except OSError:
            self.send_error(404, "File not found")
            return None

        try:
            fs = os.fstat(f.fileno())
            file_size = fs.st_size
            ctype = self.guess_type(path)

            start, end = 0, max(file_size - 1, 0)
            partial = False
            range_hdr = self.headers.get("Range")
            if range_hdr and range_hdr.startswith("bytes="):
                # 複数レンジ (bytes=0-99,200-299) は使われる場面が実質ないので最初の1件だけ扱う
                spec = range_hdr[6:].split(",", 1)[0].strip()
                m = re.match(r"^(\d*)-(\d*)$", spec)
                ok = bool(m)
                if ok:
                    s, e = m.group(1), m.group(2)
                    if s:
                        start = int(s)
                        end = min(int(e), file_size - 1) if e else file_size - 1
                    elif e:
                        # `bytes=-N` は末尾 N バイト
                        n = int(e)
                        start = max(0, file_size - n)
                        end = file_size - 1
                    else:
                        ok = False
                if not ok or start > end or start >= file_size:
                    self.send_response(416)
                    self.send_header("Content-Range", f"bytes */{file_size}")
                    self.send_header("Content-Length", "0")
                    self.end_headers()
                    f.close()
                    return None
                partial = True

            length = end - start + 1

            self.send_response(206 if partial else 200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(length))
            self.send_header("Accept-Ranges", "bytes")
            self.send_header("Last-Modified", self.date_time_string(int(fs.st_mtime)))
            if partial:
                self.send_header("Content-Range", f"bytes {start}-{end}/{file_size}")
            if download:
                # RFC 5987 の filename* で UTF-8 ファイル名にも対応
                encoded = urllib.parse.quote(os.path.basename(path))
                self.send_header(
                    "Content-Disposition",
                    f"attachment; filename*=UTF-8''{encoded}",
                )
            self.end_headers()

            if start:
                f.seek(start)
            return _RangedFile(f, length)
        except BaseException:
            f.close()
            raise

    def list_directory(self, path):
        try:
            names = os.listdir(path)
        except OSError:
            self.send_error(403, "No permission to list directory")
            return None
        # ディレクトリを先頭、次にケース非依存のアルファベット順
        names.sort(key=lambda a: (not os.path.isdir(os.path.join(path, a)), a.lower()))

        display = urllib.parse.unquote(self.path.split("?", 1)[0], errors="replace")

        rows = []
        if display != "/":
            rows.append(
                '<div class="item"><span class="icon">📁</span>'
                '<a class="name" href="../">../</a></div>'
            )
        for name in names:
            full = os.path.join(path, name)
            is_dir = os.path.isdir(full)
            href = urllib.parse.quote(name) + ("/" if is_dir else "")
            esc_name = html.escape(name + ("/" if is_dir else ""))
            if is_dir:
                rows.append(
                    f'<div class="item"><span class="icon">📁</span>'
                    f'<a class="name" href="{href}">{esc_name}</a></div>'
                )
            else:
                try:
                    size = os.path.getsize(full)
                except OSError:
                    size = 0
                rows.append(
                    '<div class="item">'
                    f'<span class="icon">{_file_icon(name)}</span>'
                    f'<a class="name" href="{href}">{esc_name}</a>'
                    f'<span class="size">{_fmt_size(size)}</span>'
                    f'<a class="dl" href="{href}?download=1" title="ダウンロード">⬇</a>'
                    '</div>'
                )

        items_html = "\n".join(rows) or '<div class="empty">空のディレクトリ</div>'
        body = INDEX_PAGE.substitute(
            title=html.escape(display), items=items_html
        ).encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        return io.BytesIO(body)

    def copyfile(self, source, outputfile):
        # クライアントがシーク/中断で接続を切っただけ。ログに残す価値なし。
        try:
            super().copyfile(source, outputfile)
        except (BrokenPipeError, ConnectionResetError):
            pass


def run_serve(argv):
    argv, public, ttl = _extract_flags(argv)
    target = os.path.expanduser(argv[0]) if argv else "."
    port = int(argv[1]) if len(argv) > 1 else 8000
    if os.path.isfile(target):
        directory, url_path = os.path.dirname(target) or ".", urllib.parse.quote(os.path.basename(target))
    elif os.path.isdir(target):
        directory, url_path = target, ""
    else:
        sys.exit(f"not found: {target}")
    handler = functools.partial(ServeHandler, directory=directory)
    run(handler, port, url_path, public=public, lifetime=ttl)


# --- dropserve: ブラウザからのドロップを保存する ---

def unique_path(name, save_dir):
    base = os.path.basename(name.replace("\\", "/")) or "unnamed"
    stem, ext = os.path.splitext(base)
    path = os.path.join(save_dir, base)
    n = 1
    while os.path.exists(path):
        path = os.path.join(save_dir, f"{stem}_{n}{ext}")
        n += 1
    return path


class _RateLimiter:
    """バイト単位の token bucket。累計消費と経過時間から必要な sleep を挟む。

    bps=0 で無効化 (何もしない)。目的は上り帯域を dropserve に 100% 食わせないこと
    で、SSH の対話性と bufferbloat 回避のための息継ぎを残す。
    """

    def __init__(self, bps):
        self.bps = bps
        self.start = None
        self.consumed = 0

    def wait(self, n):
        if self.bps <= 0 or n <= 0:
            return
        if self.start is None:
            self.start = time.monotonic()
        self.consumed += n
        expected = self.consumed / self.bps
        elapsed = time.monotonic() - self.start
        if expected > elapsed:
            time.sleep(expected - elapsed)


class _LimitedReader:
    """Content-Length ぶんまでしか rfile から読まないラッパ。keep-alive では相手が close
    しないため、Content-Length 越えの読み込みは永久ブロックする。それを止めるガード。"""

    def __init__(self, src, limit):
        self.src = src
        self.remaining = limit

    def _cap(self, n):
        if n is None or n < 0 or n > self.remaining:
            return self.remaining
        return n

    def read(self, n=-1):
        if self.remaining <= 0:
            return b""
        data = self.src.read(self._cap(n))
        self.remaining -= len(data)
        return data

    def read1(self, n=-1):
        if self.remaining <= 0:
            return b""
        data = self.src.read1(self._cap(n))
        self.remaining -= len(data)
        return data

    def readline(self, size=-1):
        if self.remaining <= 0:
            return b""
        line = self.src.readline(self._cap(size))
        self.remaining -= len(line)
        return line


class _Buffered:
    """rfile を包み、境界検出後の余分バイトを putback できるようにする薄いラッパ。"""

    def __init__(self, src):
        self.src = src
        self.buf = b""

    def read(self, n):
        # BufferedReader.read(n) は n バイト到達までブロックする仕様のため、keep-alive で
        # 相手が close しない状況では末尾で詰まる。1 syscall 分だけ返す read1 に切り替える。
        if not self.buf:
            return self.src.read1(n)
        if len(self.buf) >= n:
            data, self.buf = self.buf[:n], self.buf[n:]
            return data
        data = self.buf
        self.buf = b""
        return data + self.src.read1(n - len(data))

    def readline(self):
        i = self.buf.find(b"\n")
        if i >= 0:
            line, self.buf = self.buf[: i + 1], self.buf[i + 1 :]
            return line
        line = self.buf + self.src.readline()
        self.buf = b""
        return line

    def unread(self, data):
        if data:
            self.buf = data + self.buf


class _NullSink:
    def write(self, data):
        pass


def _read_part_headers(src):
    # ヘッダ名は ASCII だが値は RFC 7578 に従いモダンブラウザが UTF-8 の生バイトを入れてくる
    # (例: filename="日本語.zip")。latin-1 で解釈するとファイル名が化けるので値だけ UTF-8。
    headers = {}
    while True:
        line = src.readline().rstrip(b"\r\n")
        if not line:
            return headers
        k, _, v = line.partition(b":")
        headers[k.decode("latin-1").lower()] = v.strip().decode("utf-8", errors="replace")


def _copy_until_boundary(src, dst, boundary_b, limit, limiter=None):
    """src から `\\r\\n--boundary` の直前まで dst に転送する。境界の後ろは src に putback。

    書き出し総バイト数が limit を超えたら ValueError。全部メモリに載せず 1MB チャンクで流す。
    limiter を渡すとチャンク受信ごとにレート制御用の sleep が入る。
    """
    sep = b"\r\n" + boundary_b
    hold = b""
    total = 0
    keep = len(sep) - 1  # チャンク境界を跨いだ sep 検出のため末尾に残す
    while True:
        chunk = src.read(CHUNK)
        if not chunk:
            raise EOFError("multipart 本文が途中で切断されました")
        if limiter is not None:
            limiter.wait(len(chunk))
        hold += chunk
        idx = hold.find(sep)
        if idx >= 0:
            total = _flush(dst, hold[:idx], total, limit)
            src.unread(hold[idx + len(sep) :])
            return total
        if len(hold) > keep:
            emit = len(hold) - keep
            total = _flush(dst, hold[:emit], total, limit)
            hold = hold[emit:]


def _flush(dst, data, total, limit):
    if total + len(data) > limit:
        raise ValueError(f"size limit {limit >> 20}MB")
    dst.write(data)
    return total + len(data)


def _parse_and_save(rfile, boundary, save_dir, limit, limiter=None):
    """multipart/form-data を stream で読み、`name="file"` のパートを save_dir に書き出す。保存パスを返す。"""
    src = _Buffered(rfile)
    boundary_b = b"--" + boundary.encode()
    first = src.readline().rstrip(b"\r\n")
    if first != boundary_b:
        raise ValueError("先頭 boundary が見つかりません")
    saved_path = None
    while True:
        headers = _read_part_headers(src)
        cd = headers.get("content-disposition", "")
        m_name = re.search(r'name="([^"]*)"', cd)
        m_file = re.search(r'filename="([^"]*)"', cd)
        is_file = bool(m_name and m_name.group(1) == "file" and m_file)
        if is_file and saved_path is None:
            os.makedirs(save_dir, exist_ok=True)
            saved_path = unique_path(m_file.group(1) or "unnamed", save_dir)
            try:
                with open(saved_path, "wb") as f:
                    _copy_until_boundary(src, f, boundary_b, limit, limiter)
            except BaseException:
                if os.path.exists(saved_path):
                    os.remove(saved_path)
                raise
        else:
            _copy_until_boundary(src, _NullSink(), boundary_b, limit, limiter)
        tail = src.read(2)
        if tail == b"--":
            src.readline()  # 末尾 boundary の後ろの \r\n を捨てる
            return saved_path
        if tail != b"\r\n":
            raise ValueError("boundary の後ろが不正です")


class DropHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        body = PAGE.encode()
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        if self.path != "/upload":
            return self.reply(404, {"error": "not found"})
        ctype = self.headers.get("Content-Type", "")
        if "multipart/form-data" not in ctype:
            return self.reply(400, {"error": "multipart/form-data expected"})
        m = re.search(r'boundary=(?:"([^"]+)"|([^;\s]+))', ctype)
        if not m:
            return self.reply(400, {"error": "boundary missing"})
        boundary = m.group(1) or m.group(2)
        # Content-Length があれば保険で早期リジェクト (multipart オーバーヘッド 64KB 分は許容)
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = 0
        if length and length > MAX_BYTES + (64 << 10):
            self.close_connection = True
            return self.reply(413, {"error": f"size limit {MAX_BYTES >> 20}MB"})
        # Content-Length ぶんまでにキャップする。無ければ生の rfile を渡す (末尾で詰まる可能性はあるが古い挙動を維持)
        src = _LimitedReader(self.rfile, length) if length > 0 else self.rfile
        limiter = _RateLimiter(RATE_LIMIT_BPS)
        try:
            saved = _parse_and_save(src, boundary, INBOX, MAX_BYTES, limiter=limiter)
        except ValueError as e:
            self.close_connection = True
            return self.reply(413, {"error": str(e)})
        except EOFError as e:
            self.close_connection = True
            return self.reply(400, {"error": str(e)})
        if not saved:
            return self.reply(400, {"error": "no file field"})
        return self.reply(200, {"path": saved})

    def reply(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, fmt, *args):
        sys.stderr.write("%s %s\n" % (self.address_string(), fmt % args))


def run_drop(argv):
    argv, public, ttl = _extract_flags(argv)
    port = int(argv[0]) if argv else 8090
    os.makedirs(INBOX, exist_ok=True)
    print(f"保存先: {INBOX}", flush=True)
    print(f"1ファイル上限: {MAX_BYTES >> 20}MB", flush=True)
    if RATE_LIMIT_BPS > 0:
        print(f"受信レート上限: {RATE_LIMIT_BPS / 1024 / 1024:.1f} MB/s", flush=True)
    if public:
        # URL を知る誰でも巨大ファイルを投げ込めるようになる。認証なしなので用途を絞る前提で警告のみ。
        print("⚠ --public: URL を知る誰でもファイルを送れます。共有範囲に注意してください。", flush=True)
    run(DropHandler, port, public=public, lifetime=ttl)


def main():
    cmd = os.path.basename(sys.argv[0])
    if cmd == "dropserve":
        run_drop(sys.argv[1:])
    else:
        run_serve(sys.argv[1:])


if __name__ == "__main__":
    main()
