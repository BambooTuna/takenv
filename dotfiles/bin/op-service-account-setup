#!/usr/bin/env zsh
# Configure 1Password CLI to use a vault-scoped service account by default.
# Account details are runtime arguments so this script is safe to publish.

set -eu
setopt pipefail

usage() {
  cat <<'EOF'
Usage:
  op-service-account-setup --address ADDRESS --email EMAIL --vault VAULT [options]

Required:
  --address ADDRESS       1Password sign-in address
  --email EMAIL           Email address for the 1Password account
  --vault VAULT           Vault granted to the service account

Options:
  --name NAME             Service account name (default: op-cli-<hostname>)
  --expires-in DURATION   Optional expiry such as 24h, 30d, or 52w
                          Omit this option to create a non-expiring account.
  --token-file PATH       Token destination
                          (default: ~/.config/op/service-account-token)
  -h, --help              Show this help

The service account receives read_items and write_items for exactly one vault.
The token is never printed and is saved with file mode 600.
EOF
}

address=""
email=""
vault=""
service_account_name="op-cli-$(hostname -s)"
expires_in=""
token_file="${OP_SERVICE_ACCOUNT_TOKEN_FILE:-$HOME/.config/op/service-account-token}"

while (( $# > 0 )); do
  case "$1" in
    --address)
      (( $# >= 2 )) || { print -ru2 -- "Missing value for --address"; exit 2; }
      address="$2"
      shift 2
      ;;
    --email)
      (( $# >= 2 )) || { print -ru2 -- "Missing value for --email"; exit 2; }
      email="$2"
      shift 2
      ;;
    --vault)
      (( $# >= 2 )) || { print -ru2 -- "Missing value for --vault"; exit 2; }
      vault="$2"
      shift 2
      ;;
    --name)
      (( $# >= 2 )) || { print -ru2 -- "Missing value for --name"; exit 2; }
      service_account_name="$2"
      shift 2
      ;;
    --expires-in)
      (( $# >= 2 )) || { print -ru2 -- "Missing value for --expires-in"; exit 2; }
      expires_in="$2"
      shift 2
      ;;
    --token-file)
      (( $# >= 2 )) || { print -ru2 -- "Missing value for --token-file"; exit 2; }
      token_file="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      print -ru2 -- "Unknown option: $1"
      usage >&2
      exit 2
      ;;
  esac
done

if [[ -z "$address" || -z "$email" || -z "$vault" ]]; then
  print -ru2 -- "--address, --email, and --vault are required."
  usage >&2
  exit 2
fi

if [[ "$vault" == *:* ]]; then
  print -ru2 -- "Vault names containing ':' cannot be used with the 1Password permission syntax."
  exit 2
fi

for command_name in mise jq; do
  if ! command -v "$command_name" >/dev/null 2>&1; then
    print -ru2 -- "Required command not found: $command_name"
    exit 1
  fi
done

op_bin="$(mise which op)"
token_dir="${token_file:h}"

if [[ -s "$token_file" ]]; then
  print -ru2 -- "Refusing to overwrite an existing token: $token_file"
  print -ru2 -- "Revoke the old service account and remove that file before replacing it."
  exit 1
fi

install -d -m 700 "$token_dir"
chmod 700 "$token_dir"

# A service-account token from the caller must not override interactive setup.
unset OP_SERVICE_ACCOUNT_TOKEN OP_CONNECT_HOST OP_CONNECT_TOKEN

accounts_json="$("$op_bin" account list --format=json)"
address_is_configured="$(
  print -r -- "$accounts_json" | jq -r \
    --arg address "$address" \
    --arg email "$email" '
      any(.[ ];
        (.url | sub("^https?://"; "") | sub("/$"; "")) ==
          ($address | sub("^https?://"; "") | sub("/$"; "")) and
        (.email | ascii_downcase) == ($email | ascii_downcase)
      )
    '
)"

if [[ "$address_is_configured" != "true" ]]; then
  print "Adding 1Password account: $address"
  "$op_bin" account add --address "$address" --email "$email"
fi

print "Signing in to 1Password account: $address"
eval "$("$op_bin" signin --account "$address")"

create_args=(
  service-account create "$service_account_name"
  --vault "$vault:read_items,write_items"
  --raw
)
if [[ -n "$expires_in" ]]; then
  create_args+=(--expires-in "$expires_in")
fi

print "Creating service account: $service_account_name"
token="$("$op_bin" "${create_args[@]}")"
if [[ -z "$token" ]]; then
  print -ru2 -- "1Password returned an empty service account token."
  exit 1
fi

umask 077
token_tmp="$(mktemp "$token_dir/.service-account-token.XXXXXX")"
trap 'rm -f "$token_tmp"' EXIT HUP INT TERM
print -rn -- "$token" > "$token_tmp"
chmod 600 "$token_tmp"
mv "$token_tmp" "$token_file"
trap - EXIT HUP INT TERM

print "Saved token with mode 600: $token_file"
print "Vaults visible through the service account:"
env \
  -u OP_SESSION \
  -u OP_CONNECT_HOST \
  -u OP_CONNECT_TOKEN \
  OP_SERVICE_ACCOUNT_TOKEN="$token" \
  "$op_bin" vault list

unset token
print
print "Setup complete. Start a new shell with: exec zsh"
