# 最初にすべてを無視し、管理対象をホワイトリストで追記する
### all ignore ###
/*
/.**

### not ignore ###
!/.gitignore

!/.rc
!/.zshrc
!/.tmux.conf
!/.gitconfig

!/.config/
!/.config/**

!/.claude/
!/.claude/**

!/.codex/
!/.codex/**

!/.agents/
!/.agents/**

!/.gogcli/
!/.gogcli/**

!/.ssh/
!/.ssh/config

!/bin/
!/bin/**

# codex plugin のランタイム状態（sqlite 等、実行時に生成される）
/.codex/state/

# codex が承認の度に自動追記する allow ルール。業務プロジェクトのパスや
# プロンプト全文が溜まり続けるため public リポでは管理外
/.codex/rules/default.rules

# Claude Code デーモンのランタイム状態（実行時に生成される）
/.claude/daemon/
/.claude/daemon.*
/.claude/daemon-auth-*
/.claude/gh-pr-status-cache.json

# Python bytecode キャッシュ
**/__pycache__/

# hyperframes 系スキル（外部配布物のためリポジトリ管理外）
/.agents/skills/hyperframes/
/.agents/skills/hyperframes-*/
/.agents/skills/media-use/
/.agents/skills/product-launch-video/

# シークレットは絶対にコミットしない（ホワイトリストより後に置き、必ず優先させる）
**/.env
**/.env.*
!**/.env.example
**/.credentials.json

# cli-proxy-api の config は生 API キーを含むため管理外
/.config/cli-proxy-api/

# エージェントのランタイム状態（実行時に生成される）
/.claude/.ponytail-active
/.codex/thread-writer-locks/
