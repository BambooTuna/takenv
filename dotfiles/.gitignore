# 最初にすべてを無視し、管理対象をホワイトリストで追記する
### all ignore ###
/*
/.**

### not ignore ###
!/.gitignore

!/.rc
!/.zshrc
!/.tmux.conf
!/.gitconfig

!/.config/
!/.config/**

!/.claude/
!/.claude/**

!/.codex/
!/.codex/**

!/.gogcli/
!/.gogcli/**

!/bin/
!/bin/**

# x-ops スキルの個人ペルソナは公開しない
/.claude/skills/x-ops/persona/

# Claude Code デーモンのランタイム状態（実行時に生成される）
/.claude/daemon/
/.claude/daemon.*
/.claude/daemon-auth-*
/.claude/gh-pr-status-cache.json

# Python bytecode キャッシュ
**/__pycache__/

# hyperframes 系スキル（外部配布物のためリポジトリ管理外）
/.claude/skills/hyperframes/
/.claude/skills/hyperframes-*/
/.claude/skills/media-use/
/.claude/skills/product-launch-video/

# シークレットは絶対にコミットしない（ホワイトリストより後に置き、必ず優先させる）
**/.env
**/.env.*
!**/.env.example
**/.credentials.json
