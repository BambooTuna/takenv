# env
export LANG=ja_JP.UTF-8

# dropserve が上り帯域を 100% 占有しないよう天井を設定 (SSH 対話性 / bufferbloat 対策)
export DROPSERVE_RATE_MBPS=10

# alias
alias v="nvim"
alias k="kubectl"
alias t="terraform"
alias p="pm2"

# claude 起動時に共通システムプロンプトを追記する
# (サブコマンドは --append-system-prompt-file を受け付けないため素通しする)
claude() {
    case "$1" in
        agents|auth|auto-mode|doctor|install|mcp|plugin|plugins|project|setup-token|ultrareview|update|upgrade)
            command claude "$@" ;;
        *)
            command claude --append-system-prompt-file "$HOME/.claude/append-system-prompt.txt" "$@" ;;
    esac
}

# claude worktree (例: cw read, cw "fix bug #123")
cw() {
    claude --enable-auto-mode --worktree "$@"
}

# tmux ls (セッション一覧表示)
alias tls='tmux ls'

# tmux attach -t [name] (指定セッションにアタッチ)
alias ta='tmux attach -t'

# tmux new -s [name] (指定セッションを新規作成)
alias tns='tmux new -s'

# (指定セッションがあればリンクセッションでアタッチ、なければ新規作成する)
ts() {
    if [ -n "$TMUX" ]; then
        tmux switch-client -t "$1" 2>/dev/null || tmux new-session -d -s "$1" \; switch-client -t "$1"
    else
        tmux attach-session -t "$1" 2>/dev/null || tmux new-session -s "$1"
    fi
}

alias ga="git add"
alias gc="git commit -m"
alias gp="git push origin"

# git worktree add のショートカット (例: gwa feature/some -> ../feature-some)
gwa() {
    if [ -z "$1" ]; then
        echo "Usage: gwa <branch-name>"
        return 1
    fi
    local branch="$1"
    local dir="${branch//\//-}"

    # ブランチが存在するかチェック
    if git show-ref --verify --quiet "refs/heads/$branch"; then
        # 既存ブランチの場合
        git worktree add "../$dir" "$branch"
    else
        # 新規ブランチの場合
        git worktree add "../$dir" -b "$branch"
    fi
}

# AWS SSM Session Manager で zsh を直接起動する (default document は sh を起動してしまい、
# sh 名 invoked された bash は POSIX モードで .profile も .bashrc も条件次第でしか読まない = shell 側で hook 不可)。
# 使い方: ssms i-xxxx [profile] [region]  profile/region 省略時は AWS_PROFILE / AWS_REGION or 既定値
ssms() {
    if [ -z "$1" ]; then
        echo "Usage: ssms <instance-id> [profile] [region]"
        return 1
    fi
    local target="$1"
    local profile="${2:-${AWS_PROFILE:-default}}"
    local region="${3:-${AWS_REGION:-ap-northeast-1}}"
    aws ssm start-session --region "$region" --profile "$profile" \
        --target "$target" \
        --document-name AWS-StartInteractiveCommand \
        --parameters 'command=["/usr/bin/zsh -l"]'
}

# path
export GO111MODULE=on
export GOPATH=$HOME/go
export PATH="$PATH:$GOPATH/bin"

export PATH="$PATH:$HOME/bin"
export PATH="$PATH":"$HOME/.pub-cache/bin"
