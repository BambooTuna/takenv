# docker-compose の各サービスに渡す環境変数のテンプレート。
# 使い方: `cp .env.example .env` してから値を埋める。 .env は .gitignore 済み。

# tmuxui の認証トークン(URL クエリに ?token=... で渡す)。適当に生成した文字列を入れる。
TMUXUI_TOKEN=change-me

# tmuxui コンテナが動く UID/GID。ホストで tmux を起動しているユーザーの id -u / id -g と一致させる。
# 標準的な単一ユーザー Linux では 1000/1000 でよい。異なる場合のみ上書き。
# TMUXUI_UID=1000
# TMUXUI_GID=1000
